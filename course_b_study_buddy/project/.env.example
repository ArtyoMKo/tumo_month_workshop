# Copy this file, rename the copy to exactly ".env", and paste your real keys in.
#
# Then NEVER share the .env file. Not on Discord, not in a screenshot, not on GitHub.
# Anyone who has these keys can spend money with them.
#
# Rules for the lines below: no quotation marks, no spaces around the =,
# and no space at the end of the line.

# Answers your questions. Your teacher gives you this one.
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# Turns your notes into numbers so they can be searched.
# Free from huggingface.co/settings/tokens - "Read" access is all you need.
# Strictly optional: it works without one, but sixteen students on the same wifi look
# like one very busy user, and a token gives you your own allowance.
HF_TOKEN=hf_paste-your-token-here

# Only needed if you change CHAT_MODEL in config.py to one of these providers.
# Ollama needs no key at all - it runs on this computer.
#
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
